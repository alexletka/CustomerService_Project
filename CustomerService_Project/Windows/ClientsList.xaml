<UserControl x:Class="CustomerService_Project.Windows.ClientsList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:CustomerService_Project.Windows"
             mc:Ignorable="d"
             Background="{StaticResource PastelBackground}">

    <Grid Background="{StaticResource PastelBackground}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <DataGrid x:Name="ClientsDataGrid"
                  Grid.Row="1"
                  Grid.Column="0"
                  Grid.ColumnSpan="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  ColumnWidth="*"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Background="{StaticResource PastelSurface}"
                  BorderBrush="{StaticResource PastelBorder}"
                  Margin="30,10"
                  MinHeight="150">

            <DataGrid.Columns>

                <DataGridTextColumn Header="ID"
                                    Binding="{Binding Id}"
                                    Width="1*"/>

                <DataGridTextColumn Header="ФИО"
                                    Binding="{Binding FullName}"
                                    Width="2*"/>

                <DataGridTextColumn Header="Email"
                                    Binding="{Binding Email}"
                                    Width="2*"/>

                <DataGridTextColumn Header="Телефон"
                                    Binding="{Binding PhoneNumber}"
                                    Width="1.5*"/>

                <DataGridTextColumn Header="Роль"
                                    Binding="{Binding Role}"
                                    Width="1*"/>

            </DataGrid.Columns>

        </DataGrid>

        <Border Grid.Row="2"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Center"
                Background="{StaticResource PastelSurface}"
                Padding="8,12"
                Margin="20,10,20,20"
                CornerRadius="10">

            <WrapPanel HorizontalAlignment="Center"
                       VerticalAlignment="Center">

                <Button x:Name="AddButton"
                        Content="Добавить"
                        Style="{StaticResource PastelButton}"
                        Margin="5"
                        Width="120"
                        Height="48"
                        FontSize="12"
                        FontFamily="Georgia"
                        Click="AddButton_Click"/>

                <Button x:Name="EditButton"
                        Content="Редактировать"
                        Style="{StaticResource PastelButton}"
                        Margin="5"
                        Width="140"
                        Height="48"
                        FontSize="12"
                        FontFamily="Georgia"
                        Click="EditButton_Click"/>

                <Button x:Name="HistoryButton"
                        Content="История заказов"
                        Style="{StaticResource PastelButton}"
                        Margin="5"
                        Width="150"
                        Height="48"
                        FontSize="12"
                        FontFamily="Georgia"
                        Click="HistoryButton_Click"/>

                <Button x:Name="DeleteButton"
                        Content="Удалить"
                        Style="{StaticResource PastelButton}"
                        Margin="5"
                        Width="120"
                        Height="48"
                        FontSize="12"
                        FontFamily="Georgia"
                        Click="DeleteButton_Click"/>
            </WrapPanel>
        </Border>
    </Grid>
</UserControl>
