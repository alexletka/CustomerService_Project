<UserControl x:Class="CustomerService_Project.Windows.ProductsList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:CustomerService_Project.Windows"
             mc:Ignorable="d"
             Background="{StaticResource PastelBackground}">

    <Grid Background="{StaticResource PastelBackground}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Text="Поиск:"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   Margin="30,0,0,5"
                   FontSize="16"
                   FontFamily="Georgia"
                   Foreground="{StaticResource PastelText}"/>

        <TextBox Grid.Row="0"
                 Grid.Column="0"
                 x:Name="SearchBox"
                 Width="300"
                 HorizontalAlignment="Left"
                 Margin="100,20,15,10"
                 Padding="10"
                 FontSize="16"
                 FontFamily="Georgia"
                 Foreground="{StaticResource PastelText}"
                 TextChanged="SearchBox_TextChanged"/>

        <DataGrid x:Name="ProductsDataGrid"
                  Grid.Row="1"
                  Grid.Column="0"
                  Grid.ColumnSpan="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  ColumnWidth="*"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Background="{StaticResource PastelSurface}"
                  BorderBrush="{StaticResource PastelBorder}"
                  Margin="30,10"
                  MinHeight="150">

            <DataGrid.Columns>

                <DataGridTextColumn Header="ID"
                                    Binding="{Binding Id}"
                                    Width="1*"/>

                <DataGridTextColumn Header="Название"
                                    Binding="{Binding Name}"
                                    Width="2*"/>

                <DataGridTextColumn Header="Категория"
                                    Binding="{Binding Category}"
                                    Width="2*"/>

                <DataGridTextColumn Header="Цена"
                                    Binding="{Binding Price}"
                                    Width="1.5*"/>

                <DataGridTextColumn Header="На складе"
                                    Binding="{Binding StockQuantity}"
                                    Width="1.5*"/>

            </DataGrid.Columns>

        </DataGrid>

        <Border Grid.Row="2"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Center"
                Background="{StaticResource PastelSurface}"
                Padding="8,12"
                Margin="20,10,20,20"
                CornerRadius="10">

            <WrapPanel HorizontalAlignment="Center"
                       VerticalAlignment="Center">

                <Button x:Name="AddButton"
                        Content="Добавить"
                        Style="{StaticResource PastelButton}"
                        Margin="5"
                        Padding="15,8"
                        Width="150"
                        Height="48"
                        FontSize="12"
                        FontFamily="Georgia"
                        Click="AddButton_Click"/>

                <Button x:Name="EditButton"
                        Content="Редактировать"
                        Style="{StaticResource PastelButton}"
                        Margin="5"
                        Padding="15,8"
                        Width="150"
                        Height="48"
                        FontSize="12"
                        FontFamily="Georgia"
                        Click="EditButton_Click"/>

                <Button x:Name="DeleteButton"
                        Content="Удалить"
                        Style="{StaticResource PastelButton}"
                        Margin="5"
                        Padding="15,8"
                        Width="150"
                        Height="48"
                        FontSize="12"
                        FontFamily="Georgia"
                        Click="DeleteButton_Click"/>
                
            </WrapPanel>
        </Border>
    </Grid>
</UserControl>
