<Window x:Class="CustomerService_Project.Windows.Authorization"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CustomerService_Project.Windows"
        mc:Ignorable="d"
        Style="{StaticResource MaterialDesignWindow}"
        Title="Authorization"
        Height="600"
        Width="800"
        WindowStartupLocation="CenterScreen">

    <Grid Background="{StaticResource PastelBackground}">

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="50">

                <TextBlock Text="Вход в систему"
                           FontSize="64"
                           FontFamily="Georgia"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource PastelText}"/>

                <StackPanel Margin="0,20,0,0">

                    <Label Content="Email"
                           FontSize="18"
                           FontFamily="Georgia"
                           Foreground="{StaticResource PastelText}"/>

                    <TextBox Name="EmailBox"
                             Padding="20,8"
                             FontSize="16"
                             FontFamily="Georgia"/>

                </StackPanel>

                <StackPanel Margin="0,20,0,0">

                    <Label Content="Пароль"
                           FontSize="18"
                           FontFamily="Georgia"
                           Foreground="{StaticResource PastelText}"/>

                    <PasswordBox Name="PasswordInput"
                                 Padding="20,8"/>

                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                Background="{StaticResource PastelSurface}"
                CornerRadius="10"
                Padding="16,12"
                Margin="20,10,20,20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <Button Content="Войти"
                        Padding="15,0"
                        Margin="8,0"
                        Width="140"
                        Height="48"
                        FontFamily="Georgia"
                        Style="{StaticResource PastelButton}"
                        Click="LoginButton_Click"/>

                <Button Content="Регистрация"
                        Padding="15,0"
                        Margin="8,0"
                        Width="140"
                        Height="48"
                        FontFamily="Georgia"
                        Style="{StaticResource PastelButton}"
                        Click="RegistrationButton_Click"/>

                <Button Content="Закрыть"
                        Padding="15,0"
                        Margin="8,0"
                        Width="140"
                        Height="48"
                        FontFamily="Georgia"
                        Style="{StaticResource PastelButton}"
                        Click="CloseButton_Click"/>

            </StackPanel>
        </Border>

    </Grid>
</Window>