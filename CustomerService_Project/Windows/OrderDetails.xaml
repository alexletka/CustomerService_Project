<Window x:Class="CustomerService_Project.Windows.OrderDetails"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CustomerService_Project.Windows"
        mc:Ignorable="d"
        Style="{StaticResource MaterialDesignWindow}"
        Title="OrderDetails" 
        Height="600"
        Width="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PastelBackground}">
    
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="1.5*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        
        
        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Grid.ColumnSpan="4"
                   Text="Детали заказа"
                   FontSize="32"
                   FontFamily="Georgia"
                   HorizontalAlignment="Center"
                   Foreground="{StaticResource PastelText}"
                   Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   Grid.ColumnSpan="4"
                   FontSize="16"
                   FontFamily="Georgia"
                   Foreground="{StaticResource PastelText}"
                   Margin="5,0,10,8">

            <Run Text="Номер заказа: "/>
            <Run x:Name="OrderIdText" Text="-"/>

        </TextBlock>

        <TextBlock Grid.Row="2"
                   Grid.Column="0"
                   Grid.ColumnSpan="4"
                   FontSize="16"
                   FontFamily="Georgia"
                   Foreground="{StaticResource PastelText}"
                   Margin="5,0,10,8">

            <Run Text="Дата заказа: "/>
            <Run x:Name="OrderDateText" Text="-"/>

        </TextBlock>

        <TextBlock Grid.Row="3"
                   Grid.Column="0"
                   Grid.ColumnSpan="4"
                   FontSize="16"
                   FontFamily="Georgia"
                   Foreground="{StaticResource PastelText}"
                   Margin="5,0,10,15">

            <Run Text="Клиент: "/>
            <Run x:Name="ClientNameText" Text="-"/>

        </TextBlock>



        <DataGrid Grid.Row="5"
                  Grid.Column="0"
                  Grid.ColumnSpan="4"
                  x:Name="OrderDetailsDataGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  ColumnWidth="*"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Background="{StaticResource PastelSurface}"
                  BorderBrush="{StaticResource PastelBorder}"
                  Margin="0,0,0,15">

            <DataGrid.Columns>
                
                <DataGridTextColumn Header="Товар"
                                    Binding="{Binding ProductName}"
                                    Width="2*"/>

                <DataGridTextColumn Header="Количество"
                                    Binding="{Binding Quantity}"
                                    Width="2*"/>
                
                <DataGridTextColumn Header="Цена за шт."
                                    Binding="{Binding PricePerUnit, StringFormat={}{0:N2}}"
                                    Width="2*"/>

                <DataGridTextColumn Header="Сумма"
                                    Binding="{Binding LineTotal, StringFormat={}{0:N2}}"
                                    Width="1*"/>

            </DataGrid.Columns>

        </DataGrid>
        
        
        
        <TextBlock Grid.Row="6"
                   Grid.Column="0"
                   Text="Итого:"
                   FontSize="20"
                   FontFamily="Georgia"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource PastelText}"
                   Margin="0,10"/>

        <TextBlock Grid.Row="6"
                   Grid.Column="1"
                   x:Name="TotalAmountText"
                   Text="0,00"
                   FontSize="20"
                   FontFamily="Georgia"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource PastelText}"
                   VerticalAlignment="Center"
                   Margin="12,10"/>

        <Button Grid.Row="6"
                Grid.Column="3"
                Content="Закрыть"
                FontFamily="Georgia"
                Style="{StaticResource PastelButton}"
                Padding="20,8"
                HorizontalAlignment="Right"
                Margin="0,10,10,10"
                Click="CloseButton_Click"/>


    </Grid>
    
</Window>
