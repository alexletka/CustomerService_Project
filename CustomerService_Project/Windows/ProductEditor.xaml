<Window x:Class="CustomerService_Project.Windows.ProductEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CustomerService_Project.Windows"
        mc:Ignorable="d"
        Style="{StaticResource MaterialDesignWindow}"
        Title="ProductEditor" 
        Height="600" 
        Width="800">

    <Grid Background="{StaticResource PastelBackground}">

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="50">

                <TextBlock x:Name="EditorTitle"
                           Text="Данные товара"
                           FontSize="32"
                           FontFamily="Georgia"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource PastelText}"/>

                <StackPanel Margin="0,20,0,0">

                    <Label Content="Название товара"
                           FontSize="16"
                           FontFamily="Georgia"
                           Foreground="{StaticResource PastelText}"/>

                    <TextBox x:Name="NameBox"
                             Padding="20,8"
                             FontFamily="Georgia"/>

                </StackPanel>

                <StackPanel Margin="0,20,0,0">

                    <Label Content="Категория"
                           FontSize="16"
                           FontFamily="Georgia"
                           Foreground="{StaticResource PastelText}"/>

                    <TextBox x:Name="CategoryBox"
                             Padding="20,8"
                             FontFamily="Georgia"/>

                </StackPanel>

                <StackPanel Margin="0,20,0,0">

                    <Label Content="Цена"
                           FontSize="16"
                           FontFamily="Georgia"
                           Foreground="{StaticResource PastelText}"/>

                    <TextBox x:Name="PriceBox"
                             Padding="20,8"
                             FontFamily="Georgia"/>

                </StackPanel>

                <StackPanel Margin="0,20,0,0">

                    <Label Content="Количество на складе"
                           FontSize="16"
                           FontFamily="Georgia"
                           Foreground="{StaticResource PastelText}"/>

                    <TextBox x:Name="StockQuantityBox"
                             Padding="20,8"
                             FontFamily="Georgia"/>

                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                Background="{StaticResource PastelSurface}"
                CornerRadius="10"
                Padding="16,12"
                Margin="20,10,20,20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <Button x:Name="SaveButton"
                        Content="Сохранить"
                        Padding="15,0"
                        Margin="8,0"
                        Width="140"
                        Height="48"
                        FontFamily="Georgia"
                        Style="{StaticResource PastelButton}"
                        Click="SaveButton_Click"/>

                <Button x:Name="CloseButton"
                        Content="Отмена"
                        Padding="15,0"
                        Margin="8,0"
                        Width="140"
                        Height="48"
                        FontFamily="Georgia"
                        Style="{StaticResource PastelButton}"
                        Click="CloseButton_Click"/>

            </StackPanel>
        </Border>

    </Grid>
</Window>
