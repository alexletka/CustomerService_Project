<Window x:Class="CustomerService_Project.Windows.ClientEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CustomerService_Project.Windows"
        mc:Ignorable="d"
        Style="{StaticResource MaterialDesignWindow}"
        Title="ClientEditor"
        Height="600" 
        Width="800">

    <Grid Background="{StaticResource PastelBackground}">

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="50">

                <TextBlock x:Name="EditorTitle"
                           Text="Данные клиента"
                           FontSize="32"
                           FontFamily="Georgia"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource PastelText}"/>

                <StackPanel Margin="0,20,0,0">

                    <Label Content="ФИО"
                           FontSize="16"
                           FontFamily="Georgia"
                           Foreground="{StaticResource PastelText}"/>

                    <TextBox x:Name="FullNameBox"
                             Padding="20,8"
                             FontFamily="Georgia"/>

                </StackPanel>

                <StackPanel Margin="0,20,0,0">

                    <Label Content="Электронная почта"
                           FontSize="16"
                           FontFamily="Georgia"
                           Foreground="{StaticResource PastelText}"/>

                    <TextBox x:Name="EmailBox"
                             Padding="20,8"
                             FontFamily="Georgia"/>

                </StackPanel>

                <StackPanel Margin="0,20,0,0">

                    <Label Content="Номер телефона"
                           FontSize="16"
                           FontFamily="Georgia"
                           Foreground="{StaticResource PastelText}"/>

                    <TextBox x:Name="PhoneNumberBox"
                             Padding="20,8"
                             FontFamily="Georgia"/>

                </StackPanel>

                <StackPanel Margin="0,20,0,0">

                    <Label Content="Роль"
                           FontSize="16"
                           FontFamily="Georgia"
                           Foreground="{StaticResource PastelText}"/>

                    <ComboBox x:Name="RoleBox"
                              Padding="10"
                              FontFamily="Georgia"
                              SelectedIndex="0">

                        <ComboBoxItem Content="Пользователь"
                                      Tag="2"/>

                        <ComboBoxItem Content="Администратор"
                                      Tag="1"/>

                    </ComboBox>

                </StackPanel>

                <StackPanel Margin="0,20,0,0">

                    <Label Content="Пароль"
                           FontSize="16"
                           FontFamily="Georgia"
                           Foreground="{StaticResource PastelText}"/>

                    <PasswordBox x:Name="PasswordInput"
                                 Padding="20,8"
                                 FontFamily="Georgia"/>

                </StackPanel>

                <StackPanel Margin="0,20,0,0">

                    <Label Content="Повторите пароль"
                           FontSize="16"
                           FontFamily="Georgia"
                           Foreground="{StaticResource PastelText}"/>

                    <PasswordBox x:Name="PasswordRepeatInput"
                                 Padding="20,8"
                                 FontFamily="Georgia"/>

                </StackPanel>

                <TextBlock Text="При редактировании оставьте пароль пустым, если не хотите его менять."
                           TextWrapping="Wrap"
                           FontSize="12"
                           Margin="0,12,0,5"
                           Foreground="#788579"/>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                Background="{StaticResource PastelSurface}"
                CornerRadius="10"
                Padding="16,12"
                Margin="20,10,20,20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <Button x:Name="SaveButton"
                        Content="Сохранить"
                        Padding="15,0"
                        Margin="8,0"
                        Width="140"
                        Height="48"
                        FontFamily="Georgia"
                        Style="{StaticResource PastelButton}"
                        Click="SaveButton_Click"/>

                <Button x:Name="CloseButton"
                        Content="Отмена"
                        Padding="15,0"
                        Margin="8,0"
                        Width="140"
                        Height="48"
                        FontFamily="Georgia"
                        Style="{StaticResource PastelButton}"
                        Click="CloseButton_Click"/>

            </StackPanel>
        </Border>

    </Grid>
</Window>
