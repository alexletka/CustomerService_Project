<Window x:Class="CustomerService_Project.Windows.CreateOrder"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CustomerService_Project.Windows"
        mc:Ignorable="d"
        Style="{StaticResource MaterialDesignWindow}"
        Title="CreateOrder" 
        Height="600" 
        Width="800">


    <Grid Background="{StaticResource PastelBackground}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Grid.ColumnSpan="5"
                   Text="Создание заказа"
                   FontSize="32"
                   FontFamily="Georgia"
                   HorizontalAlignment="Center"
                   Foreground="{StaticResource PastelText}"
                   Margin="0,15,0,20"/>

        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   Text="Клиент:"
                   FontSize="16"
                   FontFamily="Georgia"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource PastelText}"
                   Margin="30,12,12,12"/>

        <ComboBox Grid.Row="1"
                  Grid.Column="1"
                  Grid.ColumnSpan="4"
                  x:Name="ClientComboBox"
                  DisplayMemberPath="FullName"
                  SelectedValuePath="Id"
                  Padding="10"
                  Margin="0,12,30,12"/>

        <TextBlock Grid.Row="2"
                   Grid.Column="0"
                   Text="Товар:"
                   FontSize="16"
                   FontFamily="Georgia"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource PastelText}"
                   Margin="30,12,12,12"/>

        <ComboBox Grid.Row="2"
                  Grid.Column="1"
                  x:Name="ProductComboBox"
                  DisplayMemberPath="Name"
                  SelectedValuePath="Id"
                  Padding="10"
                  Margin="0,12,10,12"
                  SelectionChanged="ProductComboBox_SelectionChanged"/>

        <TextBlock Grid.Row="2"
                   Grid.Column="2"
                   Text="Количество:"
                   FontSize="16"
                   FontFamily="Georgia"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource PastelText}"
                   Margin="5,12"/>

        <TextBox Grid.Row="2"
                 Grid.Column="3"
                 x:Name="QuantityBox"
                 Text="1"
                 Padding="10"
                 FontFamily="Georgia"
                 Margin="5,12"
                 MinWidth="60"
                 TextChanged="QuantityBox_TextChanged"/>

        <TextBlock Grid.Row="3"
                   Grid.Column="3"
                   x:Name="StockInfoText"
                   Text=""
                   Foreground="Red"
                   FontSize="12"
                   FontFamily="Georgia"
                   FontStyle="Italic"
                   Margin="5,0,0,5"
                   Visibility="Collapsed"/>

        <Button Grid.Row="2"
                Grid.Column="4"
                x:Name="AddProductButton"
                Content="Добавить"
                Style="{StaticResource PastelButton}"
                MinWidth="110"
                Height="48"
                Margin="8,12,30,12"
                FontFamily="Georgia"
                Click="AddProductButton_Click"/>

        <DataGrid Grid.Row="4"
                  Grid.Column="0"
                  Grid.ColumnSpan="5"
                  x:Name="OrderItemsDataGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  ColumnWidth="*"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Background="{StaticResource PastelSurface}"
                  BorderBrush="{StaticResource PastelBorder}"
                  Margin="30,10"
                  MinHeight="120">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Товар"
                                    Binding="{Binding ProductName}"
                                    Width="1.5*"/>

                <DataGridTextColumn Header="Количество"
                                    Binding="{Binding Quantity}"
                                    Width="2*"/>

                <DataGridTextColumn Header="Цена за шт."
                                    Binding="{Binding PricePerUnit, StringFormat={}{0:N2}}"
                                    Width="2*"/>

                <DataGridTextColumn Header="Сумма"
                                    Binding="{Binding LineTotal, StringFormat={}{0:N2}}"
                                    Width="1.5*"/>

            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="5"
                Grid.Column="0"
                Grid.ColumnSpan="5"
                Background="{StaticResource PastelSurface}"
                CornerRadius="10"
                Padding="16,12"
                Margin="20,10,20,20">

            <DockPanel LastChildFill="False"
                       VerticalAlignment="Center">

                <Button DockPanel.Dock="Right"
                        x:Name="CloseButton"
                        Content="Отмена"
                        Style="{StaticResource PastelButton}"
                        Width="100"
                        Height="48"
                        Margin="5,0"
                        FontFamily="Georgia"
                        Click="CloseButton_Click"/>

                <Button DockPanel.Dock="Right"
                        x:Name="CreateOrderButton"
                        Content="Оформить заказ"
                        Style="{StaticResource PastelButton}"
                        Width="150"
                        Height="48"
                        Margin="5,0"
                        Padding="1"
                        FontFamily="Georgia"
                        Click="CreateOrderButton_Click"/>

                <Button DockPanel.Dock="Right"
                        x:Name="RemoveProductButton"
                        Content="Убрать товар"
                        Style="{StaticResource PastelButton}"
                        Width="130"
                        Height="48"
                        Margin="5,0"
                        Padding="1"
                        FontFamily="Georgia"
                        Click="RemoveProductButton_Click"/>

                <TextBlock DockPanel.Dock="Left"
                           Text="Итого:"
                           FontSize="18"
                           FontWeight="SemiBold"
                           FontFamily="Georgia"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource PastelText}"
                           Margin="5,0"/>

                <TextBlock DockPanel.Dock="Left"
                           x:Name="TotalAmountText"
                           Text="0,00 ₽"
                           FontSize="18"
                           FontFamily="Georgia"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource PastelText}"
                           Margin="5,0"/>

            </DockPanel>
        </Border>

    </Grid>

</Window>
