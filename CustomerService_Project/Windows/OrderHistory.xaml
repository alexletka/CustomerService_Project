<Window x:Class="CustomerService_Project.Windows.OrderHistory"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CustomerService_Project.Windows"
        mc:Ignorable="d"
        Style="{StaticResource MaterialDesignWindow}"
        Title="OrderHistory" 
        Height="600"
        Width="800">

    <Grid Background="{StaticResource PastelBackground}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Text="История заказов"
                   FontSize="32"
                   FontFamily="Georgia"
                   HorizontalAlignment="Center"
                   Foreground="{StaticResource PastelText}"
                   Margin="0,15,0,20"/>

        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   Text="Клиент:"
                   FontSize="16"
                   FontFamily="Georgia"
                   Foreground="{StaticResource PastelText}"
                   VerticalAlignment="Center"
                   Margin="50,10,10,15"/>

        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   x:Name="ClientNameText"
                   Text="-"
                   FontSize="16"
                   FontFamily="Georgia"
                   Foreground="{StaticResource PastelText}"
                   VerticalAlignment="Center"
                   Margin="115,10,10,15"/>

        <DataGrid Grid.Row="2"
                  Grid.Column="0"
                  x:Name="OrdersHistoryDataGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  ColumnWidth="*"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Background="{StaticResource PastelSurface}"
                  BorderBrush="{StaticResource PastelBorder}"
                  Margin="30,10">

            <DataGrid.Columns>

                <DataGridTextColumn Header="ID заказа"
                                    Binding="{Binding Id}"
                                    Width="2*"/>

                <DataGridTextColumn Header="Дата заказа"
                                    Binding="{Binding OrderDate, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                    Width="2*"/>

                <DataGridTextColumn Header="Общая сумма"
                                    Binding="{Binding TotalAmount, StringFormat={}{0:N2}}"
                                    Width="1.5*"/>

            </DataGrid.Columns>

        </DataGrid>

        <Border Grid.Row="3"
                Background="{StaticResource PastelSurface}"
                CornerRadius="10"
                Padding="16,12"
                Margin="20,10,20,20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <Button x:Name="DetailsButton"
                        Content="Детали заказа"
                        Style="{StaticResource PastelButton}"
                        Padding="15,0"
                        Margin="8,0"
                        Width="160"
                        Height="48"
                        FontFamily="Georgia"
                        Click="DetailsButton_Click"/>

                <Button x:Name="CloseButton"
                        Content="Закрыть"
                        Style="{StaticResource PastelButton}"
                        Padding="15,0"
                        Margin="8,0"
                        Width="140"
                        Height="48"
                        FontFamily="Georgia"
                        Click="CloseButton_Click"/>

            </StackPanel>
        </Border>

    </Grid>
</Window>
